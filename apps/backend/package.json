{
  "name": "@materiaq/lyrics-api",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "author": "Sanooj E Sanish <mail@sanooj.uk>",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run sync:spicy-obj-packer && bun --bun run --hot src/index.ts",
    "build": "bun run scripts/build.ts",
    "build:start": "bun run build && bun run start",
    "start": "bun run --bun dist/index.js",
    "update-http-statuses": "bun run ./scripts/update-http-statuses.ts",
    "check": "bun run lint && bun run fmt --check",
    "email": "email dev --dir src/emails",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:drop": "drizzle-kit drop",
    "auth:generate": "drizzle-kit generate --config=drizzle-auth.config.ts",
    "auth:push": "drizzle-kit push --config=drizzle-auth.config.ts",
    "auth:migrate": "drizzle-kit migrate --config=drizzle-auth.config.ts",
    "auth:studio": "drizzle-kit studio --config=drizzle-auth.config.ts",
    "auth:drop": "drizzle-kit drop --config=drizzle-auth.config.ts",
    "db:seed-amll": "bun run ./scripts/seed-amll.ts",
    "db:seed": "bun run db:seed-amll",
    "drizzle:migrate-all": "bun run ./scripts/migrate.ts",
    "sync:spicy-obj-packer": "bun run scripts/sync-spicy-unpacker.ts",
    "auth:schema-gen": "bun x auth@latest generate --output ./src/db/schema/auth.ts",
    "test": "bun run --bun vitest"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "0.1.10",
    "@elysia/cors": "1.4.2",
    "@elysia/cron": "1.4.2",
    "@elysia/openapi": "1.4.15",
    "@romanizer/arabic": "workspace:*",
    "@romanizer/armenian": "workspace:*",
    "@romanizer/bengali": "workspace:*",
    "@romanizer/cyrillic": "workspace:*",
    "@romanizer/georgian": "workspace:*",
    "@romanizer/gothic": "workspace:*",
    "@romanizer/greek": "workspace:*",
    "@romanizer/gujarati": "workspace:*",
    "@romanizer/hebrew": "workspace:*",
    "@romanizer/hindi": "workspace:*",
    "@romanizer/malayalam": "workspace:*",
    "@romanizer/persian": "workspace:*",
    "@romanizer/punjabi": "workspace:*",
    "@romanizer/tamil": "workspace:*",
    "@romanizer/telugu": "workspace:*",
    "@romanizer/urdu": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "@valibot/to-json-schema": "1.7.1",
    "better-auth": "catalog:",
    "drizzle-orm": "0.45.2",
    "elysia": "catalog:",
    "elysia-helmet": "3.1.0",
    "elysia-rate-limit": "4.6.2",
    "fast-xml-parser": "5.8.0",
    "fastest-levenshtein": "1.0.16",
    "kuromoji.js": "0.1.6",
    "kuroshiro": "1.2.0",
    "lru-cache": "11.5.2",
    "nodemailer": "8.0.9",
    "pinyin": "4.0.0",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.9.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.3",
    "@types/bun": "catalog:types",
    "@types/nodemailer": "8.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.18",
    "@workspace/typescript-config": "workspace:*",
    "bun-plugin-pino": "1.5.0",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "13.1.3",
    "ts-morph": "28.0.0",
    "tsx": "4.22.3",
    "vitest": "catalog:testing"
  },
  "packageManager": "bun@1.4.2"
}
