## Databases
POSTGRES_LYRICS_URL="postgresql://materiaq:materiaq_password@localhost:5432/lyrics"
POSTGRES_AUTH_URL="postgresql://materiaq:materiaq_password@localhost:5432/auth"
VALKEY_URL="redis://:materiaq_valkey_password@localhost:6379"

## Authentication
### Generate with: openssl rand -base64 32 
AUTH_SECRET="super_secure_secret"
AUTH_BASE_URL="http://localhost:3000"

## Mail
SMTP_PASS="your-app-pass"
SMTP_USER="yourmail@example.com"
SMTP_SERVICE="gmail"
MAIL_FROM_ADDRESS="noreply@yourmail.com"

## OAuth Provider Credentials
### Setup instructions: https://better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
### Setup instructions for Discord: https://better-auth.com/docs/authentication/discord
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"

## Spotify
SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"

# Spotify sp_dc cookie (Optional but highly recommended)
# Prevents aggressive rate-limiting, Spicy might not like anonymous sp_dc.
# To get it: Log into open.spotify.com -> DevTools (F12) -> Application -> Cookies -> 'sp_dc'.
SP_DC="your_sp_dc_cookie_here"

## Apple Music
APPLE_AUTH_TOKEN="Bearer your_apple_auth_token_here"
APPLE_MEDIA_USER_TOKEN="your_apple_media_user_token_here"
APPLE_STOREFRONT="in"


## Server
EMAIL_BASE_URL="http://localhost:3000"
PORT="3000"
NODE_ENV="production"
VERIFY_CLOUDFLARE_IP_IN_APP="false"
ADMIN_MAIL="admin@example.com"

## CI (only used in tests)
CI="false"

## Lyrics storage
### true  → store every available lyrics source in the DB
### false → store only the best available lyrics (default: false)
STORE_ALL_LYRICS="false"

## Cache TTLs (in ms)
### How long to cache a "not found" result for a brand-new track (default: 259200000  — 3 days)
LYRICS_NEW_NOT_FOUND_TTL="259200000"

### How long to cache a "not found" result for an older track (default: 2592000000 — 30 days)
LYRICS_NOT_FOUND_TTL="2592000000"

### How long to cache found lyrics (default: 1382400000 — 16 days)
LYRICS_CACHE_TTL="1382400000"

### How long the client should cache a response (default: 604800000  — 7 days)
CLIENT_CACHE_TTL="604800000"

## Timeouts
### Request timeout for Spotify / Apple / lyrics APIs (in ms, default: 12000)
FETCH_TIMEOUT="12000"


## Proxies
### Optional, this is to bypass the spicy lyrics api newline-separated list 
### Format: ip:port:username:password
### Example: 127.0.0.1:8080:user:securepassword
PROXIES=""